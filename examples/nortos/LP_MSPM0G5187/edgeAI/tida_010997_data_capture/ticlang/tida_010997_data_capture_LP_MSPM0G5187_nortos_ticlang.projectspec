<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <applicability>
        <when>
            <context
                deviceFamily="ARM"
                deviceId="MSPM0G5187"
            />
        </when>
    </applicability>

    <project
        title="tida_010997_data_capture"
        name="tida_010997_data_capture_LP_MSPM0G5187_nortos_ticlang"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM0G5187"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -DDEVICE_NAME=MSPM0G5187
            @device.opt
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -Iexamples/edgeAI/tida_010997_data_capture/device_agent_protocol
            -Iexamples/edgeAI/tida_010997_data_capture/comm
            -Iexamples/edgeAI/tida_010997_data_capture/sensors
            -Iexamples/edgeAI/tida_010997_data_capture/sensors/ambient_light
            -Iexamples/edgeAI/tida_010997_data_capture/sensors/digital_mic
            -Iexamples/edgeAI/tida_010997_data_capture/sensors/hall_effect
            -Iexamples/edgeAI/tida_010997_data_capture/sensors/humidity_temperature
            -Iexamples/edgeAI/tida_010997_data_capture/sensors/imu
            -Iexamples/edgeAI/tida_010997_data_capture/sensors/pressure
            -I${PROJECT_ROOT}/comm
            -I${PROJECT_ROOT}/sensors
            -I${PROJECT_ROOT}/sensors/hall_effect
            -I${PROJECT_ROOT}/sensors/humidity_temperature
            -I${PROJECT_ROOT}/sensors/imu
            -I${PROJECT_ROOT}/sensors/pressure
            -I${PROJECT_ROOT}/sensors/ambient_light
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/edgeAI/device_agent_protocol/core
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/edgeAI/device_agent_protocol/uart_comm
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -gdwarf-3
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
            -Wall
        "
        linkerBuildOptions="
            -ldevice.cmd.genlibs
            -L${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM0_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="Multi-sensor data capture example for TIDA-010997 reference design with MSPM0">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="../tida_010997_data_capture.c" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../device_agent_protocol/dap_interface.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="device_agent_protocol">
        </file>
        <file path="../device_agent_protocol/dap_interface.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="device_agent_protocol">
        </file>
        <file path="../comm/i2c_comm.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../comm/i2c_comm.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../comm/spi_comm.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../comm/spi_comm.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="comm">
        </file>
        <file path="../sensors/sensor.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors">
        </file>
        <file path="../sensors/sensor.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors">
        </file>
        <file path="../sensors/ambient_light/sensor_OPT4001.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/ambient_light">
        </file>
        <file path="../sensors/ambient_light/sensor_OPT4001.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/ambient_light">
        </file>
        <file path="../sensors/hall_effect/sensor_TMAG5170.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/hall_effect">
        </file>
        <file path="../sensors/hall_effect/sensor_TMAG5170.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/hall_effect">
        </file>
        <file path="../sensors/humidity_temperature/sensor_HDC3020.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/humidity_temperature">
        </file>
        <file path="../sensors/humidity_temperature/sensor_HDC3020.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/humidity_temperature">
        </file>
        <file path="../sensors/imu/sensor_BMI270.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/imu">
        </file>
        <file path="../sensors/imu/sensor_BMI270.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/imu">
        </file>
        <file path="../sensors/pressure/sensor_BMP384.c" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/pressure">
        </file>
        <file path="../sensors/pressure/sensor_BMP384.h" openOnCreation="false" excludeFromBuild="false" action="copy" targetDirectory="sensors/pressure">
        </file>
        <file path="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/edgeAI/device_agent_protocol/core/dap_core.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="ti/edgeAI/device_agent_protocol/core">
        </file>
        <file path="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/edgeAI/device_agent_protocol/uart_comm/uart_comm_target.c" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="ti/edgeAI/device_agent_protocol/uart_comm">
        </file>
        <file path="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/edgeAI/device_agent_protocol/core/dap_core.h" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="ti/edgeAI/device_agent_protocol/core">
        </file>
        <file path="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/edgeAI/device_agent_protocol/uart_comm/uart_comm_target.h" openOnCreation="false" excludeFromBuild="false" action="link" targetDirectory="ti/edgeAI/device_agent_protocol/uart_comm">
        </file>
        <file path="../README.md" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
        <file path="../README.html" openOnCreation="false" excludeFromBuild="false" action="copy">
        </file>
        <file path="../tida_010997_data_capture.syscfg" openOnCreation="true" excludeFromBuild="false" action="copy">
        </file>
    </project>
</projectSpec>